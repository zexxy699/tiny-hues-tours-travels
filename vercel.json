{
  "functions": {
    "api/**/*.js": {
      "regions": ["bom1"]
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/outputs/index.html" },
    { "source": "/styles.css", "destination": "/outputs/styles.css" },
    { "source": "/app.js", "destination": "/outputs/app.js" },
    { "source": "/admin.js", "destination": "/outputs/admin.js" },
    { "source": "/adminapage", "destination": "/outputs/admin.html" },
    { "source": "/adminapage/", "destination": "/outputs/admin.html" },
    { "source": "/assets/:path*", "destination": "/outputs/assets/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
